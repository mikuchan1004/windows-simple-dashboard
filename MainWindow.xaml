<Window x:Class="Windows_Simple_DashBoard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Simple DashBoard" Height="550" Width="900"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize" Icon="/Dashboard.png"
        Background="#121212">
    <!-- 배경을 더 깊은 검은색으로 설정 -->

    <Window.Resources>
        <!-- [1] 카드 스타일 최적화: 가독성을 위해 불투명도와 그림자 강화 -->
        <Style x:Key="DashboardCard" TargetType="Border">
            <Setter Property="Background" Value="#F21A1A1A"/>
            <!-- 95% 불투명한 짙은 회색 -->
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            <!-- 미세한 테두리로 배경과 분리 -->
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.4"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SlimProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryAccent}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource WindowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- [2] 배경 이미지 레이어: 가독성을 위해 Opacity를 더 낮추고 블러 추가 -->
        <Grid Grid.RowSpan="3">
            <Image Source="/Miku_Jirai.jpg"
                   Stretch="UniformToFill"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Opacity="0.2"/>
          

            <!-- 아래로 갈수록 어두워지는 그라데이션으로 하단 텍스트 가독성 확보 -->
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#00121212" Offset="0"/>
                        <GradientStop Color="#99121212" Offset="0.8"/>
                        <GradientStop Color="#FF121212" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
        </Grid>

        <!-- 상단 영역 -->
        <DockPanel Grid.Row="0" Margin="25,25,25,10" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="심플 대시보드" FontSize="26" FontWeight="Bold" Foreground="White">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="5" ShadowDepth="1" Opacity="0.8"/>
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock Text="사용중인 PC의 상태를 보여줍니다" FontSize="13" Foreground="#99FFFFFF" Margin="0,5,0,0"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="다크모드" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="White"/>
                <CheckBox x:Name="ThemeSwitch" Click="ThemeSwitch_Click" IsChecked="{Binding ElementName=MainWindow, Path=IsDarkModeInitial}"/>
            </StackPanel>
        </DockPanel>

        <!-- 중단 영역 (드라이브 정보) -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="15,10">
            <ItemsControl x:Name="DriveItemsControl">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" VerticalAlignment="Top"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{DynamicResource DashboardCard}" 
        Background="#991A1A1A" 
        Margin="5"
        MouseLeftButtonDown="DriveCard_MouseLeftButtonDown"
        Cursor="Hand">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <!-- 드라이브 명칭 가독성 강화 -->
                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold" Margin="0,0,0,12" Foreground="White" />
                                <ProgressBar Grid.Row="1" Value="{Binding UsagePercentage}" Foreground="{Binding UsageColor}" Style="{StaticResource SlimProgressBar}"/>
                                <DockPanel Grid.Row="2" Margin="0,8,0,0">
                                    <TextBlock Text="{Binding UsageText}" FontSize="12" Foreground="#BBFFFFFF" FontWeight="Medium"/>
                                    <TextBlock Text="{Binding SpaceText}" FontSize="12" Foreground="#88FFFFFF" HorizontalAlignment="Right"/>
                                </DockPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- [3] 하단 영역: 시스템 요약 -->
        <StatusBar Grid.Row="2" Background="#CC121212" BorderBrush="#33FFFFFF" BorderThickness="0,1,0,0" Padding="15,8">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <!-- 작동 시간 -->
                            <ColumnDefinition Width="Auto" />
                            <!-- CPU -->
                            <ColumnDefinition Width="Auto" />
                            <!-- RAM -->
                            <ColumnDefinition Width="Auto" />
                            <!-- 상태 -->
                            <ColumnDefinition Width="*" />
                            <!-- 공백 -->
                            <ColumnDefinition Width="Auto" />
                            <!-- 깃허브 주소 -->
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>

            <!-- 작동 시간 (Margin으로 간격 확보) -->
            <StatusBarItem Grid.Column="0" Background="Transparent" Margin="0,0,15,0">
                <TextBlock x:Name="UptimeTextBlock" Text="작동 시간: 00:00:00" Foreground="#BBFFFFFF" FontSize="11"/>
            </StatusBarItem>

            <!-- CPU 정보 -->
            <StatusBarItem Grid.Column="1" Background="Transparent" Margin="0,0,15,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="CPU: " FontSize="11" Foreground="#88FFFFFF"/>
                    <TextBlock x:Name="CpuTextBlock" Text="0.0%" FontSize="11" Foreground="White" FontWeight="Bold"/>
                </StackPanel>
            </StatusBarItem>

            <!-- RAM 정보 -->
            <StatusBarItem Grid.Column="2" Background="Transparent" Margin="0,0,15,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="RAM: " FontSize="11" Foreground="#88FFFFFF"/>
                    <TextBlock x:Name="RamTextBlock" Text="0.0% (0.0GB Free)" FontSize="11" Foreground="#88FFFFFF" FontWeight="Bold"/>
                </StackPanel>
            </StatusBarItem>

            <!-- 상태 정보 (박스의 주범인 Separator 제거 후 배치) -->
            <StatusBarItem Grid.Column="3" Background="Transparent">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="상태: " FontSize="11" Foreground="#88FFFFFF"/>
                    <TextBlock Text="좋음" FontSize="11" Foreground="#00FF7F" FontWeight="Bold"/>
                </StackPanel>
            </StatusBarItem>

            <!-- 깃허브 주소 -->
            <StatusBarItem Grid.Column="5" HorizontalAlignment="Right" Background="Transparent">
                <TextBlock>
            <Hyperlink NavigateUri="https://github.com/mikuchan1004" RequestNavigate="Hyperlink_RequestNavigate" Foreground="#00ACEE" FontWeight="SemiBold">
                github.com/mikuchan1004
            </Hyperlink>
                </TextBlock>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>