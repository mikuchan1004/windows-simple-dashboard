<Application x:Class="Windows_Simple_DashBoard.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Windows_Simple_DashBoard"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- 기본은 라이트 모드로 설정 -->
        <ResourceDictionary x:Name="ThemeDictionary">
            <SolidColorBrush x:Key="WindowBackground" Color="#F3F3F3"/>
            <SolidColorBrush x:Key="CardBackground" Color="White"/>
            <SolidColorBrush x:Key="PrimaryAccent" Color="#0078D4"/>
            <SolidColorBrush x:Key="PrimaryText" Color="#333333"/>
            <SolidColorBrush x:Key="SecondaryText" Color="#666666"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
